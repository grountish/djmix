{
  "name": "djmix",
  "version": "1.0.0",
  "description": "DJ-style track analysis and BPM-based mixing application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && NODE_ENV=development electron .",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder",
    "build:win": "npm run build:electron -- --win nsis --x64",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "playwright test",
    "analyze": "tsx scripts/analyze.ts",
    "mixlab": "tsx scripts/mixlab.ts"
  },
  "keywords": [
    "dj",
    "music",
    "audio",
    "bpm",
    "mixing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "music-metadata": "^11.12.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "signalsmith-stretch": "^1.3.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "node-web-audio-api": "^2.2.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^5.0.5",
    "wait-on": "^9.0.5"
  }
}
